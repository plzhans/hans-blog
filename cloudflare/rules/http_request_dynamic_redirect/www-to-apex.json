{
  "ref": "www-to-apex",
  "description": "[www-to-apex] www.plzhans.com을 plzhans.com(비-www)으로 301 리다이렉트 - canonical/OG/JSON-LD가 전부 비-www 기준이라 도메인 통일",
  "expression": "(http.host eq \"www.plzhans.com\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://plzhans.com\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  }
}
