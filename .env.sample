# Notion Integration API 토큰
NOTION_API_TOKEN=
# Notion 데이터베이스 ID
NOTION_DATABASE_ID=
# GitHub Personal Access Token (repo 권한 필요)
GITHUB_PAT=

# Gemini 이미지 생성 API 키 (mcp/ 의 generate_featured_image 도구에서 사용)
# https://aistudio.google.com/apikey 에서 발급
# 이미지 생성은 무료 등급 불가. 결제 등록된 유료 등급이어야 한다
GEMINI_API_KEY=

# 링크드인 앱 (https://www.linkedin.com/developers/apps)
# Auth 탭의 Client ID / Client Secret. 만료되지 않으므로 여기 둔다
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 액세스 토큰과 person URN 은 여기 없다.
# 인증하면서 생기는 파생값이라 make linkedin-auth 가 .linkedin-session.json 에 직접 써넣는다
# (추적하지 않는 파일). 액세스 토큰은 60일이면 죽으므로 만료되면 같은 명령을 다시 돌린다.
#
# CI 에는 그 파일이 없으므로 같은 내용을 LINKEDIN_SESSION 시크릿에 통째로 넣는다
# (make linkedin-auth 가 재인증할 때마다 gh 로 갱신한다). 코드가 파일 대신 그 값을 읽는다.
