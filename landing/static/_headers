# Workers Static Assets does not add charset to Content-Type the way GitHub Pages
# did, so clients that trust the header decoded Korean text as ISO-8859-1.
/*.html
  Content-Type: text/html; charset=utf-8

/
  Content-Type: text/html; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-landing.xml
  Content-Type: application/xml; charset=utf-8

/ads.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

# Workers Static Assets defaults to max-age=0, must-revalidate. Edge caching is
# handled by Workers. On overlap the longest literal prefix wins, not order.
/*
  Cache-Control: public, max-age=600

# Service card images. Fixed names that rarely change.
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000
