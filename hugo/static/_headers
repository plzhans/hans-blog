# Zone Cache Rules do not apply to Worker responses, and Workers Static Assets
# defaults to max-age=0, must-revalidate. Edge caching is handled by Workers.
# On overlap the longest literal prefix wins, not declaration order.

/*
  Cache-Control: public, max-age=600

# Holds both Hugo-processed (_hu_<hash>) and unresized originals, which this
# file cannot tell apart, so both get the shorter TTL.
/posts/:slug/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/css/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Content-hashed index files only. Fixed-name runtime (pagefind-ui.js, wasm,
# pagefind-entry.json) is left at the default so version bumps take effect.
/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/pagefind/filter/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/pagefind/*.pf_meta
  ! Cache-Control
  Cache-Control: public, max-age=2592000
